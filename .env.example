# Application settings
APP_ENV=local
DATABASE_URL=localhost:5432
POSTGRESQL_URL=postgresql://user:password@localhost:5432/fnb_voc
OPENAI_API_KEY=
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=fake-v1
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=100
RAG_RETRIEVAL_MODE=hybrid
RAG_TOP_K=5
RAG_CONTEXT_MAX_ITEMS=5
RAG_CONTEXT_MAX_CHARS=6000
GENERATOR_PROVIDER=fake
GENERATOR_MODEL=fake-v1
RAG_MINIMUM_EVIDENCE=1
EVALUATION_DATASET_PATH=data/processed/rag_evaluation.jsonl
EVALUATION_RETRIEVAL_K=5
EVALUATION_RECALL_THRESHOLD=0.7
EVALUATION_PRECISION_THRESHOLD=0.5
EVALUATION_CITATION_THRESHOLD=0.8
EVALUATION_EVALUATOR_MODE=deterministic
POSTGRES_DB=fnb_voc
POSTGRES_USER=fnb
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DASHBOARD_PORT=8501

# ServIQ 로컬 API와 Docker Compose 프로필 설정
SERVIQ_REPOSITORY=postgres
SERVIQ_DATABASE_URL=postgresql://fnb:change-me@localhost:5432/fnb_voc
SERVIQ_API_PORT=8000
SERVIQ_FRONTEND_PORT=8080
# 개발용 예시 Incident가 필요할 때만 true로 변경합니다.
SERVIQ_SEED_DEMO=false
