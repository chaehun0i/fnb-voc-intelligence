# 기본 메모리 모드는 프로세스 종료 시 데이터가 사라집니다.
SERVIQ_REPOSITORY=memory
SERVIQ_SEED_DEMO=false
# 실제 Gemini 사용 시 로컬 .env에만 키를 입력합니다. 키는 공유하지 않습니다.
GEMINI_API_KEY=
MODEL=gemini-3.5-flash-lite
# 로컬 명시적 호출을 허용합니다. 운영에서는 Tenant Config Version을 사용합니다.
SERVIQ_LLM_ENABLED=false
GENERATOR_PROVIDER=fake
# 검토되지 않은 자유 텍스트 VOC는 외부 모델로 전송하지 않습니다.
RAG_LLM_INPUT_REVIEWED=false
# PostgreSQL 사용 시 아래 두 값을 설정하고 DB 초기화 명령을 먼저 실행합니다.
# SERVIQ_REPOSITORY=postgres
# SERVIQ_DATABASE_URL=postgresql://serviq:local-password@localhost:5432/serviq
